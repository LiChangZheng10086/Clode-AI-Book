# ── Clode AI Book — 环境变量示例 ──────────────────────────
# 复制此文件为 .env 并填入真实值：
#   cp backend/.env.example backend/.env
#
# 所有带 # REQUIRED 标记的为必填项。
# ────────────────────────────────────────────────────────────

# LLM API 配置
# DeepSeek (或任意 OpenAI-compatible API)
LLM_API_KEY=sk-your-api-key-here          # REQUIRED: DeepSeek / OpenAI API Key
# LLM_BASE_URL=https://api.deepseek.com/v1  # 可选，默认 DeepSeek
# LLM_MODEL=deepseek-chat                   # 可选，默认 deepseek-chat

# PostgreSQL 数据库
# 本地开发：确保 PostgreSQL 运行在 localhost:5432
# Docker：docker-compose.yml 自动覆盖此值
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/clode_ai_book
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:123456@localhost:5432/clode_ai_book

# Redis（可选，当前主要作为 Celery 后端）
# REDIS_URL=redis://localhost:6379/0

# 调试模式
# DEBUG=true
